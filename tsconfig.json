{
  "compilerOptions": {
    "types": ["compression", "cors", "express", "node"],
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "paths": {
      "@useCases/*": ["application/useCases/*"],
      "@services/*": ["domain/services/*"],
      "@adapters/*": ["infrastructure/adapters/*"],
      "@config/*": ["infrastructure/config/*"],
      "@constants/*": ["infrastructure/constants/*"],
      "@mappers/*": ["infrastructure/mappers/*"],
      "@queries/*": ["infrastructure/queries/*"],
      "@schemas/*": ["infrastructure/schemas/*"],
      "@utils/*": ["infrastructure/utils/*"],
      "@interfaces/*": ["interfaces/*"],
      "@controllers/*": ["interfaces/controllers/*"],
      "@routes/*": ["interfaces/routes/*"]
    },
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictNullChecks": true,
    "allowSyntheticDefaultImports": true,
    "emitDecoratorMetadata": false,
    "experimentalDecorators": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
